// The chat Worker. Separate from site/wrangler.jsonc (the site owns the custom domain);
// this Worker only takes its own /api paths (routes below). Workers on routes run before a
// Custom Domain Worker, so those reach here and every other path stays the site's.
// Deploy ONLY with `npm run worker:deploy` from the repo root (never a bare `wrangler deploy`).
// Secrets (wrangler secret put, from the Boss OS vault; never in vars):
//   CHAT_TOKEN_SECRET (32+ bytes), IP_HASH_SECRET (32+ bytes), PBS_GEMINI_API_KEY,
//   OPENROUTER_API_KEY, REVENUECAT_SECRET_KEY. Optional during a rotation: CHAT_TOKEN_SECRET_PREVIOUS.
//   Only while a store reviews the app: REVIEW_CODE (10 digits) and REVIEW_UNTIL (end date); see src/review.ts.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "peace-be-still-chat",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // Only the chat Worker's own paths (never /api/*): the site Worker answers the rest of /api, such as the
  // waitlist remove link and /api/social-visits (site/test/api-routes.test.mjs keeps the two lists apart).
  "routes": [
    { "pattern": "peacebestillapp.com/api/token*", "zone_name": "peacebestillapp.com" },
    { "pattern": "peacebestillapp.com/api/chat*", "zone_name": "peacebestillapp.com" },
    { "pattern": "peacebestillapp.com/api/report", "zone_name": "peacebestillapp.com" },
    { "pattern": "peacebestillapp.com/api/memory", "zone_name": "peacebestillapp.com" },
    { "pattern": "peacebestillapp.com/api/story-art/*", "zone_name": "peacebestillapp.com" },
    { "pattern": "peacebestillapp.com/api/made-for-you*", "zone_name": "peacebestillapp.com" },
    { "pattern": "peacebestillapp.com/api/admin/*", "zone_name": "peacebestillapp.com" },
    { "pattern": "peacebestillapp.com/api/review*", "zone_name": "peacebestillapp.com" }
  ],
  // Story artwork (src/storyart.ts): approved images and their manifest; the deploy script creates the bucket.
  "r2_buckets": [{ "binding": "STORY_ART", "bucket_name": "pbs-story-art" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "peace-be-still-chat",
      // Created 21 Nov 2026 (first production deploy). The deploy script still refuses an all-zero id.
      "database_id": "472cc560-8ee6-43fd-89ca-21953d4400de",
      "migrations_dir": "migrations"
    }
  ],
  "ai": { "binding": "AI", "remote": true },
  // Burst limits on top of the D1 daily counters (Workers Rate Limiting, per location, per key).
  "ratelimits": [
    { "name": "CHAT_BURST", "namespace_id": "3101", "simple": { "limit": 12, "period": 60 } },
    { "name": "TOKEN_BURST", "namespace_id": "3102", "simple": { "limit": 3, "period": 60 } },
    // Store review code tries per install (src/review.ts); the daily cap for everyone is in D1.
    { "name": "REVIEW_BURST", "namespace_id": "3103", "simple": { "limit": 5, "period": 60 } }
  ],
  // Every hour on the hour (UTC). Day boundaries are decided in code in America/Chicago.
  "triggers": { "crons": ["0 * * * *"] },
  // Console lines (codes only) are kept; invocation logs are off because they record the request
  // (and so the client IP), and the privacy policy says IP addresses are stored only as one-way hashes.
  "observability": { "enabled": true, "head_sampling_rate": 1, "logs": { "enabled": true, "invocation_logs": false } },
  "vars": {
    // Free allowances, re-measured 20 Nov 2026 (round-2 fix). Re-check monthly against chat_counts.
    // - Workers AI: 10,000 neurons a day, reset 00:00 UTC. Measured per call on her account:
    //   risk screen (llama-3.1-8b, ~480 tokens in) 2.7 neurons on every message; risk confirm (llama-3.3-70b)
    //   ~19 neurons, only when the screen flags risk; judge (llama-3.3-70b, ~1,100 in) ~24 neurons;
    //   an answer on llama-3.3-70b ~109 neurons. So Workers AI is kept for safety and judging:
    //   400 screens (1,080) + 100 confirms (1,900) + 250 judge calls (6,000) + 5 answers (545) = 9,525 neurons.
    //   The judge falls back to Gemini when its 250 are used.
    // - Gemini free (PBS_GEMINI_API_KEY project), one rung per model, each with its own daily quota
    //   (resets midnight Pacific). The per-model RPD is shown only in AI Studio (aistudio.google.com/rate-limit):
    //   200 per model is a floor, SUSPECTED until read there. A 429 that names a PerDay quota marks the rung
    //   out for the day (measured); a 503 or a per-minute 429 is retried, never "resting".
    // - OpenRouter: the vault key is off the free tier (1,000 free requests a day) with a $0 spend limit;
    //   only ":free" ids run, with max_price 0. Free models are rate-limited upstream one by one, so the
    //   rung rotates through OPENROUTER_MODELS. 900 keeps room under 1,000 for the rotation's own tries.
    // Answer capacity on paper: 10 + 2 x 200 + 900 = 1,310 calls; a message takes ~1.3 (regenerations) and
    // a paid one adds a memory call. The ceiling below is set from the judge's 300 calls (the first
    // allowance to run out) and the live red team's measured rate (phase-3-result.md), not from paper.
    "CHAT_GLOBAL_MESSAGES_DAILY": "220",
    "CHAT_IP_MESSAGES_DAILY": "120",
    "TOKENS_PER_IPV4_DAILY": "20",
    "TOKENS_PER_IPV6_DAILY": "3",
    "WORKERS_AI_ANSWER_CALLS_DAILY": "5",
    "WORKERS_AI_RISK_CALLS_DAILY": "400",
    "WORKERS_AI_JUDGE_CALLS_DAILY": "250",
    "WORKERS_AI_RISK_CONFIRM_CALLS_DAILY": "100",
    "GEMINI_CALLS_DAILY": "200",
    "OPENROUTER_CALLS_DAILY": "900",
    "WORKERS_AI_ANSWER_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "WORKERS_AI_JUDGE_MODEL": "@cf/openai/gpt-oss-120b",
    "JUDGE_MAX_TOKENS": "1500",
    "WORKERS_AI_RISK_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8-fast",
    "WORKERS_AI_RISK_CONFIRM_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "GEMINI_MODELS": "gemini-3.5-flash-lite,gemini-3.1-flash-lite",
    "OPENROUTER_MODELS": "google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3.5-super-vl:free,nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free",
    // Two lanes (21 Nov 2026). Free: GEMINI_MODELS on the free-tier key, then the free fallbacks.
    // Paid (her ruling 21 Nov 2026): DeepSeek V4.1 Flash over OpenRouter, served only by the named US
    // zero-retention hosts in this order (DeepInfra is the cheapest; Together, Fireworks if it is down),
    // never a free model and never DeepSeek's own API; then Gemini (PAID_BACKUP_MODEL) on the billed
    // key. The ledger records what OpenRouter billed for each call; these prices (the dearest named
    // host, per million tokens, from OpenRouter's endpoint list 21 Nov 2026) are only its fallback.
    "PAID_PROVIDER": "openrouter-zdr",
    "PAID_MODEL": "deepseek/deepseek-v4.1-flash",
    "PAID_HOSTS": "deepinfra,together,fireworks",
    "PAID_PRICE_IN_PER_M": "0.30",
    "PAID_PRICE_OUT_PER_M": "1.20",
    "PAID_PRICE_CACHED_PER_M": "0.006",
    "PAID_BACKUP_MODEL": "gemini-3.5-flash-lite",
    // Her memory note is rewritten every this many paid messages (a paid call each time), from the turns since.
    "MEMORY_EVERY": "3",
    "GEMINI_THINKING_LEVEL": "minimal",
    "ANSWER_MAX_TOKENS": "350",
    "PAID_ANSWER_MAX_TOKENS": "600",
    "CHAT_HISTORY_TURNS": "6",
    "PAID_AI_MONTHLY_CAP_USD": "100",
    // The private first chat (her ruling 21 Nov 2026): at most this many new installs a day get it (about $0.60 a day).
    "FIRST_PRIVATE_PER_DAY": "300",
    "DEVICECHECK_HOST": "https://api.devicecheck.apple.com",
    "SAFETY_MONTHLY_CAP_USD": "10",
    "CRISIS_MODEL": "gemini-3.5-flash-lite",
    "CRISIS_THINKING_LEVEL": "low",
    "CRISIS_PRICE_IN_PER_M": "0.30",
    "CRISIS_PRICE_OUT_PER_M": "2.50",
    // Hidden monthly AI backstop per subscriber, so she nets at least $1 a month on each plan after
    // Apple's share (APPLE_SHARE; app/src/config/products.json has the prices; controls.test.ts checks
    // price x (1 - share) - backstop >= 1). At Apple's 30% today: yearly 1.33, monthly 4.59. Once she is
    // in Apple's Small Business Program (15%), raise them to 1.83 and 5.79 and APPLE_SHARE to 0.15.
    "APPLE_SHARE": "0.30",
    "CHAT_USER_MONTHLY_USD_YEARLY": "1.33",
    "CHAT_USER_MONTHLY_USD_MONTHLY": "4.59",
    "REVENUECAT_ENTITLEMENT": "paid",
    "REVIEW_CODE_VERSION": "v1",
    "CHAT_TOKEN_KID": "k1"
  }
}
