{
  "name": "peace-be-still",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "library": "tsx src/player/build-library.ts && tsx src/content/build.ts",
    "eas-build-post-install": "npm run -s library",
    "prestart": "npm run -s library",
    "start": "expo start",
    "pretypecheck": "npm run -s library",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.unit.ts && node test/support/render-build.mjs",
    "prepreview:web": "npm run -s library",
    "preview:web": "expo export --platform web"
  },
  "dependencies": {
    "@expo-google-fonts/figtree": "^0.4.1",
    "@expo-google-fonts/libre-caslon-text": "^0.4.0",
    "@expo-google-fonts/spline-sans-mono": "^0.4.2",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-community/datetimepicker": "9.2.1",
    "expo": "~58.1.0",
    "expo-asset": "~58.0.20",
    "expo-audio": "~58.0.12",
    "expo-brightness": "~58.0.3",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.9",
    "expo-dev-client": "~58.0.22",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.11",
    "expo-image": "~58.0.19",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.10",
    "expo-router": "~58.0.33",
    "expo-sharing": "~58.0.24",
    "expo-speech": "~58.0.4",
    "expo-splash-screen": "~58.0.15",
    "expo-sqlite": "~58.0.18",
    "expo-updates": "~58.0.23",
    "i18n-js": "^4.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-purchases": "^11.0.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "sql.js": "1.13.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.3.1",
    "@types/sql.js": "1.4.9",
    "esbuild": "^0.28.2",
    "ignore": "5.3.0",
    "react-test-renderer": "^19.3.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "@react-native-async-storage/async-storage"
      ]
    }
  }
}
