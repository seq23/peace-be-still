    "@expo-google-fonts/spline-sans-mono": "^0.4.2",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "expo": "58.0.22",
    "expo-asset": "~58.0.20",
    "expo-audio": "~58.0.12",
    "expo-brightness": "~58.0.3",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.18",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.11",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.29",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.18",
    "i18n-js": "^4.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-purchases": "^11.0.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "^15.16.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.3.1",
    "esbuild": "^0.28.2",
    "react-test-renderer": "^19.3.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3"
  }
