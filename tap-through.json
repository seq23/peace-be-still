  "promises": [
    { "text": "Unlimited Bible chat", "on": "paywall:plans", "built": "paid-chat:private" },
    { "text": "Private for your first 50 messages each day", "on": "paywall:plans", "built": "paid-chat:private" },
    { "text": "after that, chat keeps going, just not private.", "on": "paywall:plans", "native_only": "paid chat past the day's private messages" },
    { "text": "Your private chats are never used to train AI.", "on": "paywall:plans", "built": "paid-chat:private" },
    { "text": "The chat remembers what you share.", "on": "paywall:plans", "built": "chat-memory:memory" },
    { "text": "A sleep session every night, plus ones made for you.", "on": "paywall:plans", "built": "paid-night:open" },
    { "text": "A sleep session every night, plus ones made for you.", "on": "paywall:plans", "built": "made-for-you:form" },
    { "text": "What you write for a session made for you goes to free AI services first, and they may use it for training.", "on": "paywall:plans", "built": "made-for-you:form" },
    { "text": "Every past story, and reading plans of 30 days and more.", "on": "paywall:plans", "built": "paid-stories:past-story" },
    { "text": "Every past story, and reading plans of 30 days and more.", "on": "paywall:plans", "built": "paid-plan:day-30" },
    { "text": "Declaration topics and offline downloads.", "on": "paywall:plans", "built": "paid-topics:topics" },
    { "text": "Declaration topics and offline downloads.", "on": "paywall:plans", "built": "paid-download:download" },
    { "text": "Write your own night: your moment, read softly as you fall asleep.", "on": "paywall-mindset:plans", "built": "own-night-write:playing" }
  ],
  "native_only": [
    { "feature": "in-app purchase and Restore Purchases", "why": "the web preview has no store: Restore is disabled and Join is preview-only", "simulator": "a StoreKit sandbox purchase on the simulator build (GitHub macOS runner, free: public repo)" },
    { "feature": "the daily reminder notification", "why": "local notifications only exist on a phone", "simulator": "the simulator build" },
    { "feature": "offline downloads and background audio", "why": "file storage and lock-screen audio only exist on a phone", "simulator": "the simulator build" },
    { "feature": "paid chat past the day's private messages", "why": "the preview run never sends a chat, so the server's offer to keep chatting (not private) after the private messages never appears; guarded by worker/test/controls.test.ts and app/test/chat.render.tsx" },
    { "feature": "recording her moment in her own voice", "why": "the web preview has no microphone; it offers the marked TEST recording instead, and a phone build never has that file", "simulator": "an iPhone build on a real phone (reviewer device step, ## Not built)" },
    { "feature": "the phone voice and the night playing on with the screen locked", "why": "speech and lock-screen audio only exist on a phone", "simulator": "an iPhone build on a real phone (reviewer device step, ## Not built)" }
