{
  "name": "peace-be-still-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "peacebestillapp.com", "custom_domain": true },
    { "pattern": "www.peacebestillapp.com", "custom_domain": true }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "peace-be-still", "database_id": "4ae8e428-96d0-4053-967d-088978a526b2", "migrations_dir": "migrations" }
  ],
  "ratelimits": [
    { "name": "WAITLIST_RL", "namespace_id": "1101", "simple": { "limit": 5, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
