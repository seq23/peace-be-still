{
  "name": "peace-be-still-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "peacebestillapp.com", "custom_domain": true },
    { "pattern": "www.peacebestillapp.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
